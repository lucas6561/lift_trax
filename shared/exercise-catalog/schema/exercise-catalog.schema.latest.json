{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifttrax.local/schemas/exercise-catalog.schema.v1.json",
  "title": "LiftTrax exercise catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exercises"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled",
          "region",
          "main",
          "muscles",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "enabled": {
            "type": "boolean"
          },
          "region": {
            "enum": [
              "UPPER",
              "LOWER"
            ]
          },
          "main": {
            "enum": [
              "BENCH_PRESS",
              "OVERHEAD_PRESS",
              "SQUAT",
              "DEADLIFT",
              "CONDITIONING",
              "ACCESSORY",
              "MOBILITY",
              null
            ]
          },
          "muscles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "BICEP",
                "TRICEP",
                "NECK",
                "LAT",
                "QUAD",
                "HAMSTRING",
                "CALF",
                "LOWER_BACK",
                "CHEST",
                "FOREARM",
                "REAR_DELT",
                "FRONT_DELT",
                "SHOULDER",
                "CORE",
                "GLUTE",
                "TRAP"
              ]
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 10000
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "key"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": ".*\\S.*"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": ".*\\S.*"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": ".*\\S.*"
              }
            }
          }
        }
      }
    }
  }
}
